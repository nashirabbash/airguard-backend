// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum RoomStatus {
  NORMAL
  WARNING
  DANGER
}

model users {
  id Int @id @default(autoincrement())
  username String @unique
  password String @map("password_hash")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  deviceConfigs deviceConfig[]
}

model sensorReadings {
  id Int @id @default(autoincrement())
  deviceId String
  timestamp DateTime @default(now())
  temperature Float
  humidity Float
  mq135Value Float
  roomStatus RoomStatus
}

model deviceConfig {
  id Int @id @default(autoincrement())
  deviceId String @unique
  deviceTokenHash String
  userId Int
  user users @relation(fields: [userId], references: [id])
  tempUnsafeHigh Float
  tempUnsafeLow Float
  tempWarningLow Float
  tempWarningHigh Float
  humidityUnsafeHigh Float
  humidityUnsafeLow Float
  humidityWarningLow Float
  humidityWarningHigh Float
  mq135BaselineRuntimeOnly Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
